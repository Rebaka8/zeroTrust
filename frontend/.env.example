# =================================================================
# Zero Trust IoT Frontend - Environment Configuration
# ================================================================

# For Local Development (proxied via Vite):
# VITE_API_BASE_URL=/api/v1
# VITE_WS_URL=http://localhost:8085/ws

# For Production (When deployed to Vercel/Netlify connected to Render backend):
# Replace with your actual Render backend service URL:
VITE_API_BASE_URL=https://zerotrust-iot-backend.onrender.com/api/v1
VITE_WS_URL=https://zerotrust-iot-backend.onrender.com/ws

# Blockchain / Web3 (Sepolia or Hardhat)
VITE_CHAIN_ID=31337
VITE_RPC_URL=http://127.0.0.1:8545
